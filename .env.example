# ============================================================
# cora-docker-tomcat – environment variables
# Copy this file to .env and adjust for your deployment.
# ============================================================

# AJP connector shared secret (required when using AJP)
# WARNING: This value MUST be changed before deployment.
AJP_SECRET=REPLACE_WITH_RANDOM_SECRET

# JVM / Tomcat tuning (optional – defaults are set in the Dockerfile)
# CATALINA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/urandom
